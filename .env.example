# Frontend: leave empty for local development (Vite proxies /game-socket to port 3001).
# Production builds load the Render address from .env.production.
# Hosting build variables override these files; use wss://browserfps-server.onrender.com.
# A bare server address automatically uses the /game-socket endpoint.
VITE_GAME_SERVER_URL=
VITE_DEV_MODE=false

# Backend. For LAN hosting, HOST=0.0.0.0 and add the actual frontend origin below.
HOST=127.0.0.1
PORT=3001
MAX_PLAYERS=20
MAX_ROOMS=32
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173

# Enable only while diagnosing local development combat.
DEV_COMBAT_LOGS=false
