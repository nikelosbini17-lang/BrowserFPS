    "test:production": "npm run build && node tests/production-smoke.js"
  },
  "dependencies": {
    "three": "^0.186.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "vite": "^8.3.1"
  }
}
