{
  "name": "linebreak-fps",
  "version": "0.3.0-alpha",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node --env-file-if-exists=.env server/server.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
